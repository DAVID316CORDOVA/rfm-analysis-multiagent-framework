# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=olimpobet-prd
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Athena Configuration
ATHENA_DATABASE=dwh_raw_pe
ATHENA_OUTPUT_LOCATION=s3://dlk-olimpo/athena-results/

# Lambda Configuration
LAMBDA_FUNCTION_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws
LAMBDA_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300
MAX_STEPS=8
MAX_TOKENS=4096

# Development
DEBUG=false
ENVIRONMENT=production
